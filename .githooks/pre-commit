#!/usr/bin/env bash
set -e

echo "── Pre-commit checks ──────────────────────"

# Stage relevant files
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.php$' || true)

if [ -z "$STAGED_PHP" ]; then
    echo "No PHP files staged — skipping format/lint."
else
    echo "→ Formatting..."
    vendor/bin/mago fmt --check 2>/dev/null || {
        echo "✗ Format check failed. Run 'composer fmt' to fix."
        exit 1
    }

    echo "→ Linting..."
    vendor/bin/mago lint 2>/dev/null || {
        echo "✗ Lint failed."
        exit 1
    }

    echo "→ Static analysis..."
    vendor/bin/mago analyze src --minimum-fail-level=warning 2>/dev/null || {
        echo "✗ Static analysis failed."
        exit 1
    }
fi

echo "→ Type coverage..."
vendor/bin/pest --type-coverage --min=100 --compact 2>/dev/null || {
    echo "✗ Type coverage below 100%."
    exit 1
}

echo "→ Running tests..."
vendor/bin/pest --quiet --no-coverage 2>/dev/null || {
    echo "✗ Tests failed."
    exit 1
}

echo "✓ All checks passed."
