{
    "name": "lens/openapi",
    "description": "OpenAPI 3.1 spec generator for Tempest PHP — static analysis, no runtime execution.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "tempest/core": "3.x-dev",
        "tempest/router": "3.x-dev",
        "tempest/http": "3.x-dev",
        "tempest/database": "3.x-dev",
        "tempest/validation": "3.x-dev",
        "tempest/mapper": "3.x-dev",
        "tempest/view": "3.x-dev",
        "tempest/container": "3.x-dev",
        "tempest/discovery": "3.x-dev",
        "tempest/reflection": "3.x-dev",
        "tempest/support": "3.x-dev",
        "tempest/console": "3.x-dev",
        "nikic/php-parser": "^5.3",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-type-coverage": "^3.6",
        "carthage-software/mago": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "Lens\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lens\\Tests\\": "tests"
        }
    },
    "extra": {
        "tempest": {
            "can-discover": true
        }
    },
    "scripts": {
        "setup": "git config core.hooksPath .githooks",
        "openapi": "bin/openapi",
        "type-coverage": "vendor/bin/pest --type-coverage --min=100 --compact",
        "test": "vendor/bin/pest tests/Types tests/Extensions tests/Discovery --coverage --min=100",
        "test:ci": "@test",
        "test:local": "vendor/bin/pest tests/Types tests/Extensions tests/Discovery --no-coverage",
        "fmt": "vendor/bin/mago fmt",
        "fmt:check": "vendor/bin/mago fmt --check",
        "lint": "vendor/bin/mago lint",
        "analyze": "vendor/bin/mago analyze src --minimum-fail-level=warning",
        "qa": [
            "@fmt:check",
            "@lint",
            "@analyze",
            "@type-coverage",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
